# Database connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/myapp?sslmode=disable
# Maximum database pool connections
DB_MAX_CONNS=10
# HTTP server binding address
HTTP_ADDR=0.0.0.0:8080
# Tracing log level: trace, debug, info, warn, error
LOG_LEVEL=info
# Log format: pretty, json
LOG_FORMAT=pretty
# Automatically apply migrations on startup (true/false)
MIGRATE_ON_START=true
# Graceful shutdown budget in seconds
SHUTDOWN_TIMEOUT_SECS=30
# Per-module toggles
MODULE_AUDIT_ENABLED=true
MODULE_AUDIT_VISIBLE=true
